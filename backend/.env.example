# Copy to backend/.env. Never commit the real file.
APP_ENV=development
HOST=127.0.0.1
PORT=8000
# Supabase Auth: project URL and publishable/anon key (not service role).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Backend-only secret/service-role API key. Never expose to frontend clients.
SUPABASE_SECRET_KEY=
DATABASE_TRANSPORT=supabase
# Optional alternative: DATABASE_TRANSPORT=postgres and direct/session-pool URL.
DATABASE_URL=
# Explicitly choose supported models. No implicit paid model default.
OPENROUTER_API_KEY=
MODEL_CHAT=anthropic/claude-haiku-5.5
MODEL_FAST=anthropic/claude-haiku-5.5
MODEL_RESEARCH=openai/gpt-6-luna
MODEL_FALLBACK=
# Use json_object for models supporting JSON mode but not strict schema output.
# Both modes are validated locally against the Pydantic schema.
STRUCTURED_OUTPUT_MODE=json_schema
# Optional supported reasoning effort; low reserves more room for visible output.
MODEL_REASONING_EFFORT=low
SERPER_API_KEY=
SERPER_GL=us
SERPER_HL=en
# Optional semantic retrieval; leave both blank to use keyword retrieval.
MODEL_EMBEDDING=
EMBEDDING_DIMENSIONS=1536
# Supabase auth user UUIDs allowed to review posts/administer sources.
EDITOR_USER_IDS=[]
# Legacy editorial endpoints do not approve autonomous posts.
PUBLISHER_USER_ID=
AUTONOMOUS_PUBLISHING_ENABLED=false
# Dedicated Auth account only; never put the Supabase secret/service-role key here.
PUBLISHER_ACCESS_TOKEN=
PUBLISHER_REFRESH_TOKEN=
# Optional restart-safe sign-in when a rotated refresh token is no longer usable.
PUBLISHER_EMAIL=
PUBLISHER_PASSWORD=
# Experimental structured decisions; existing routing remains authoritative.
DECISION_MODE=off
DECISION_PRIMARY_MODEL=perplexity/pplx-decider-v1.1-27b
DECISION_FALLBACK_MODEL=typesafe/jev-1.13
DECISION_ESCALATION_MODEL=openai/gpt-6-luna-decisions
DECISION_MIN_CONFIDENCE=0.8
DECISION_PRICE_CEILING_PER_MILLION=1
CORS_ORIGINS=[]
MAX_SEARCHES=4
MAX_PAGES=8
DEEP_MAX_SEARCHES=10
DEEP_MAX_PAGES=24
# Chat reader limits stay within the existing tool/spend ceilings.
CHAT_WEB_SUCCESS_PAGES=4
CHAT_URL_SUCCESS_PAGES=2
CHAT_DEEP_SUCCESS_PAGES=8
CHAT_WEB_SEARCH_ITERATIONS=2
CHAT_DEEP_SEARCH_ITERATIONS=2
MAX_MODEL_CALLS=12
MAX_OUTPUT_TOKENS=2400
# Chat limits selected by gateway tier and routed workflow; no billing-error shrinking.
CHAT_ROUTER_OUTPUT_TOKENS=768
CHAT_SIMPLE_OUTPUT_TOKENS=768
CHAT_NORMAL_OUTPUT_TOKENS=1200
CHAT_CODING_OUTPUT_TOKENS=2000
CHAT_WEB_OUTPUT_TOKENS=1800
CHAT_DEEP_OUTPUT_TOKENS=6000
# Read-only key/org limit check before the first Chat Serper request.
# Unlimited key caps do not prove account balance; 402 handling remains mandatory.
PROVIDER_CREDIT_PREFLIGHT_ENABLED=true
CHAT_HISTORY_MAX_BYTES=8000
CHAT_HISTORY_EXCERPT_BYTES=2000
MAX_TOTAL_TOKENS=32000
# Hard cost reservation uses this conservative price upper bound.
# Set >= the highest per-token input/output rate of ALL configured models.
MODEL_PRICE_CEILING_PER_MILLION=50
MAX_RUN_COST_USD=1.50
RUN_TIMEOUT_SECONDS=240
HTTP_TIMEOUT_SECONDS=20
FETCH_MAX_BYTES=2000000
WORKER_POLL_SECONDS=3
JOB_LEASE_SECONDS=360
API_REQUESTS_PER_MINUTE=30
# Discovery is opt-in. Source registry is configured through admin API.
DISCOVERY_ENABLED=false
DISCOVERY_INTERVAL_SECONDS=1800
DISCOVERY_AUTO_RESEARCH=false
RECHECK_ENABLED=false
RECHECK_MIN_AGE_HOURS=24
